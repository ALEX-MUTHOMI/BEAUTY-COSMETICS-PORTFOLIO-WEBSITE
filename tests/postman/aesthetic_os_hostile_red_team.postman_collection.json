            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{hostile_hold_key_a}}-race\",\n  \"selection_type\": \"normal\",\n  \"service_public_id\": \"{{service_public_id}}\",\n  \"resource_public_id\": \"{{resource_public_id}}\",\n  \"starts_at\": \"{{hostile_starts_at}}\",\n  \"customer\": {\n    \"full_name\": \"Race Alpha\",\n    \"email\": \"race.a.{{hostile_run_id}}@example.invalid\",\n    \"phone\": \"+254711000002\"\n  }\n}"
            },
            "url": "{{base_url}}/api/bookings/holds/"
          }
        },
        {
          "name": "Race Hold B same slot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('race B status recorded', function () {",
                  "  pm.environment.set('hostile_race_b', String(pm.response.code));",
                  "  pm.expect([200, 201, 409, 400]).to.include(pm.response.code);",
                  "});",
                  "pm.test('at most one hold wins the slot', function () {",
                  "  const a = pm.environment.get('hostile_race_a');",
                  "  const b = String(pm.response.code);",
                  "  const success = (code) => code === '200' || code === '201';",
                  "  if (success(a) && success(b)) {",
                  "    pm.expect.fail('both race holds succeeded — exclusion constraint failed');",
                  "  }",
                  "  pm.expect(success(a) || success(b) || a === '409' || b === '409' || a === '400' || b === '400').to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRFToken", "value": "{{csrf_token}}" },
              { "key": "Cookie", "value": "csrftoken={{csrf_cookie}}" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Referer", "value": "{{csrf_referer}}" },
              { "key": "X-Forwarded-Proto", "value": "https" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{hostile_hold_key_b}}-race\",\n  \"selection_type\": \"normal\",\n  \"service_public_id\": \"{{service_public_id}}\",\n  \"resource_public_id\": \"{{resource_public_id}}\",\n  \"starts_at\": \"{{hostile_starts_at}}\",\n  \"customer\": {\n    \"full_name\": \"Race Beta\",\n    \"email\": \"race.b.{{hostile_run_id}}@example.invalid\",\n    \"phone\": \"+254711000003\"\n  }\n}"
            },
            "url": "{{base_url}}/api/bookings/holds/"
          }
        }
      ]
    },
