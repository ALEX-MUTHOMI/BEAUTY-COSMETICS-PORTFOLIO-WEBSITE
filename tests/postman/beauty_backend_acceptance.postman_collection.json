{
  "info": {
    "_postman_id": "9cb79448-5447-4db1-9f9c-beautybackend",
    "name": "Beauty Backend API Acceptance",
    "description": "External-client API acceptance for Beauty SaaS backend. Uses fake/local providers only and asserts routing, CSRF, permissions, response shape, lifecycle, and security-negative behavior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function nextBusinessDate(offsetDays) {",
          "  const now = new Date();",
          "  let candidate = new Date(now.getTime() + offsetDays * 24 * 60 * 60 * 1000);",
          "  while (candidate.getDay() === 0) {",
          "    candidate = new Date(candidate.getTime() + 24 * 60 * 60 * 1000);",
          "  }",
          "  return candidate.toISOString().slice(0, 10);",
          "}",
          "if (!pm.environment.get('run_id')) {",
          "  const runId = String(Date.now());",
          "  pm.environment.set('run_id', runId);",
          "  const normalDate = nextBusinessDate(7);",
          "  const packageDate = nextBusinessDate(8);",
          "  pm.environment.set('normal_date', normalDate);",
          "  pm.environment.set('full_package_date', packageDate);",
          "  pm.environment.set('normal_starts_at', normalDate + 'T09:00:00+03:00');",
          "  pm.environment.set('hold_idempotency_key', 'newman-hold-' + runId);",
          "  pm.environment.set('checkout_idempotency_key', 'newman-checkout-' + runId);",
          "}",
          "if (!pm.environment.get('staff_password')) {",
          "  pm.environment.set('staff_password', ['LocalApiAcceptance', 'Passphrase!', '2026'].join(''));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is never an unhandled 5xx', function () {",
          "  pm.expect(pm.response.code, pm.info.requestName).to.be.below(500);",
          "});",
          "pm.test('response does not expose internal sensitive contract fields', function () {",
          "  const body = pm.response.text().toLowerCase();",
          "  ['ledger_id', 'checkout_session_id', 'provider_payload', 'raw_payload', 'token_hash', 'session_key', 'original_private_key', 'quarantine_key', 'storage_secret', 'traceback', '/app/'].forEach(function (needle) {",
          "    pm.expect(body, needle + ' leaked in ' + pm.info.requestName).to.not.include(needle);",
          "  });",
          "});",
          "pm.test('known local secrets are not echoed', function () {",
          "  const body = pm.response.text();",
          "  ['staff_password'].forEach(function (key) {",
          "    const value = pm.environment.get(key);",
          "    if (value) { pm.expect(body).to.not.include(value); }",
          "  });",
          "});"
        ]
      }
    }
  ],
