    {
      "name": "04 Staff Portal and Gallery",
      "item": [
        {
          "name": "Staff Login Requires CSRF Cookie Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const json = pm.response.json();",
                  "pm.expect(json.display_name).to.be.a('string').and.not.empty;",
                  "pm.expect(json.permissions).to.be.an('array');",
                  "pm.expect(json.next).to.be.a('string');",
                  "pm.expect(pm.response.text().toLowerCase()).to.not.include('password');",
                  "const setCookieHeaders = pm.response.headers.all().filter((header) => header.key.toLowerCase() === 'set-cookie').map((header) => header.value).join('; ');",
                  "const sessionMatch = setCookieHeaders.match(/sessionid=([^;]+)/);",
                  "const cookieJarSession = pm.cookies.get('sessionid');",
                  "pm.environment.set('sessionid', cookieJarSession || (sessionMatch ? sessionMatch[1] : ''));",
                  "pm.expect(pm.environment.get('sessionid')).to.be.a('string').and.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Forwarded-Proto",
                "value": "https"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrf_token}}"
              },
              {
                "key": "Cookie",
                "value": "csrftoken={{csrf_token}}"
              },
              {
                "key": "Referer",
                "value": "{{csrf_referer}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staff_email}}\",\n  \"password\": \"{{staff_password}}\"\n}"
