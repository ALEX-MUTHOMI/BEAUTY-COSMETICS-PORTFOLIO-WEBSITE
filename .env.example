# Local development / sandbox verification template. Never commit real values.

DEBUG=False
SECRET_KEY=replace-with-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://frontend:3000,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://frontend:3000,http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=True
DISABLE_DJANGO_ADMIN=False
DRF_DISABLE_BROWSABLE_API=False
LOG_LEVEL=INFO

POSTGRES_DB=beauty_db
POSTGRES_USER=beauty_user
POSTGRES_PASSWORD=replace-with-local-postgres-password
REDIS_PASSWORD=replace-with-local-redis-password

PAYMENT_PROVIDER_MODE=fake
CHECKOUT_MPESA_PROVIDER=fake

DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=replace-with-sandbox-consumer-key
DARAJA_CONSUMER_SECRET=replace-with-sandbox-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=replace-with-sandbox-passkey
DARAJA_CALLBACK_URL=https://example-tunnel.test/api/checkout/mpesa/webhook/
DARAJA_ACCOUNT_REFERENCE=BEAUTYTEST
DARAJA_TRANSACTION_DESC=BEAUTYTEST
DARAJA_TEST_MSISDN=replace-with-env-only-msisdn
DARAJA_TEST_AMOUNT=1
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONNECT_TIMEOUT_SECONDS=2
DARAJA_READ_TIMEOUT_SECONDS=5
DARAJA_TOKEN_CACHE_TTL_SECONDS=3300
DARAJA_ALLOWED_SANDBOX_IPS=127.0.0.1/32

DARAJA_REQUIRE_CALLBACK=false
DARAJA_CALLBACK_WAIT_SECONDS=0
DARAJA_CALLBACK_POLL_INTERVAL_SECONDS=5
DARAJA_SANDBOX_ALLOW_TUNNEL_CALLBACKS=false
DARAJA_SANDBOX_CALLBACK_TUNNEL_DOMAINS=trycloudflare.com,ngrok-free.app

SAFARICOM_ALLOWED_CIDRS=196.201.214.0/24,196.201.216.0/24,127.0.0.1/32
TRUSTED_PROXY_CIDRS=

PAYMENT_STK_CLIENT_TIMEOUT_SECONDS=45
PAYMENT_STATUS_POLL_INTERVAL_SECONDS=5
PAYMENT_STATUS_MAX_WAIT_SECONDS=300

NUXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-public-turnstile-site-key
NUXT_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
