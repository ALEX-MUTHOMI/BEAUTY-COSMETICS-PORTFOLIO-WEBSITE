DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=replace-with-sandbox-consumer-key
DARAJA_CONSUMER_SECRET=replace-with-sandbox-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=replace-with-sandbox-passkey
DARAJA_CALLBACK_URL=https://example-tunnel.test/api/checkout/mpesa/webhook/
