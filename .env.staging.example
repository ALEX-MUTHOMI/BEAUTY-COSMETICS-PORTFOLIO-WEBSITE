# Copy to .env.staging on the staging host. Never commit real values.

STAGING_PUBLIC_HOST=staging-api.example.com

DEBUG=False
SECRET_KEY=replace-with-staging-secret
ALLOWED_HOSTS=staging-api.example.com
CSRF_TRUSTED_ORIGINS=https://staging-api.example.com
CORS_ALLOWED_ORIGINS=https://staging-api.example.com
SECURE_SSL_REDIRECT=True
DISABLE_DJANGO_ADMIN=True
DRF_DISABLE_BROWSABLE_API=True
LOG_LEVEL=INFO

POSTGRES_DB=beauty_staging
POSTGRES_USER=beauty_staging_user
POSTGRES_PASSWORD=replace-with-staging-password
REDIS_PASSWORD=replace-with-staging-redis-password

PAYMENT_PROVIDER_MODE=fake
CHECKOUT_MPESA_PROVIDER=fake

DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=replace-with-sandbox-consumer-key
DARAJA_CONSUMER_SECRET=replace-with-sandbox-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=replace-with-sandbox-passkey
DARAJA_CALLBACK_URL=https://staging-api.example.com/api/checkout/mpesa/webhook/
DARAJA_ACCOUNT_REFERENCE=BEAUTYTEST
DARAJA_TRANSACTION_DESC=BEAUTYTEST
DARAJA_TEST_MSISDN=replace-with-env-only-msisdn
DARAJA_TEST_AMOUNT=1
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONNECT_TIMEOUT_SECONDS=2
DARAJA_READ_TIMEOUT_SECONDS=5
DARAJA_TOKEN_CACHE_TTL_SECONDS=3300

DARAJA_REQUIRE_CALLBACK=true
DARAJA_CALLBACK_WAIT_SECONDS=300
DARAJA_CALLBACK_POLL_INTERVAL_SECONDS=5
DARAJA_SANDBOX_ALLOW_TUNNEL_CALLBACKS=false
DARAJA_SANDBOX_CALLBACK_TUNNEL_DOMAINS=

SAFARICOM_ALLOWED_CIDRS=196.201.214.0/24,196.201.216.0/24
TRUSTED_PROXY_CIDRS=

PAYMENT_STK_CLIENT_TIMEOUT_SECONDS=45
PAYMENT_STATUS_POLL_INTERVAL_SECONDS=5
PAYMENT_STATUS_MAX_WAIT_SECONDS=300
